# Make a base output directory
mkdir -p daphnia_genomes
cd daphnia_genomes

# NCBI Accessions and folder names
declare -A ncbi_ids
ncbi_ids=(
  ["GCF_021134715.1"]="GCF_021134715.1"
  ["GCF_022539665.2"]="GCF_022539665.2"
  ["GCF_020631705.1"]="GCF_020631705.1"
)

# Download NCBI genomes
for accession in "${!ncbi_ids[@]}"; do
  folder="${ncbi_ids[$accession]}"
  echo "Downloading NCBI genome: $accession into folder: $folder"
  mkdir -p "$folder"
  datasets download genome accession "$accession" --include genome,gtf,annotation-report
  unzip -q "$accession.zip" -d "$folder"
  rm "$accession.zip"
done


