# Download idaphnia genomes into species folders
for species in "${!idaphnia_urls[@]}"; do
  mkdir -p "$species"
  for url in ${idaphnia_urls[$species]}; do
    echo "Downloading $url into folder $species"
    wget -q --show-progress -P "$species" "$url"
  done
done

